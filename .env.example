# Optional variables for `docker compose` (copy to `.env` and adjust).
# All of them have a default value in docker-compose.yml.

# Ports published on the host.
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# API URL used by the frontend from the browser.
VITE_API_BASE_URL=http://localhost:8000

# Set to "enabled" to serve API responses from the existing MSW handlers in development.
VITE_API_MOCKING=disabled

# To run the backend outside Docker against the compose Postgres.
# Its port must match POSTGRES_PORT: if you change POSTGRES_PORT (e.g. because
# port 5432 is already taken on the host), update the port here as well.
DATABASE_URL=postgresql+psycopg://mister:mister@localhost:5432/mister
