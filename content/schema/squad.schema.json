{
  "$defs": {
    "PlayerEntry": {
      "additionalProperties": false,
      "description": "A player in a club-season squad. `sources` back his membership of the squad.\n\n`rating` and `age` may be `null` only while the player is `verify: pending`.\n`rating_rationale` is required for a verified `key` player and, in the playable\nclub-season, for every verified player (the loader checks the latter).",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Age"
        },
        "alias_name": {
          "minLength": 1,
          "title": "Alias Name",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "joined_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joined On"
        },
        "key": {
          "title": "Key",
          "type": "boolean"
        },
        "left_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left On"
        },
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rating"
        },
        "rating_rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating Rationale"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "subrole": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subrole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "player_id",
        "display_name",
        "alias_name",
        "position",
        "age",
        "rating",
        "key"
      ],
      "title": "PlayerEntry",
      "type": "object"
    },
    "Position": {
      "description": "Broad position of a player. It decides the engine line, never `subrole`.",
      "enum": [
        "GK",
        "DF",
        "MF",
        "FW"
      ],
      "title": "Position",
      "type": "string"
    },
    "RealLeague": {
      "additionalProperties": false,
      "description": "The league the club really played that season, with its real goals (P6).\n\n`competition_label` is free text (e.g. the name of the real league). It is compared with\nthe standings only when it equals the name of a league of the playable season.",
      "properties": {
        "competition_label": {
          "minLength": 1,
          "title": "Competition Label",
          "type": "string"
        },
        "goals_against": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Goals Against"
        },
        "goals_for": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Goals For"
        },
        "played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Played"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition_label",
        "played",
        "goals_for",
        "goals_against"
      ],
      "title": "RealLeague",
      "type": "object"
    },
    "Subrole": {
      "description": "Optional finer role; it must be coherent with the position.",
      "enum": [
        "CB",
        "LB",
        "RB",
        "DM",
        "CM",
        "AM",
        "WG",
        "ST"
      ],
      "title": "Subrole",
      "type": "string"
    },
    "Tactic": {
      "additionalProperties": false,
      "description": "A playing style plus a system.",
      "properties": {
        "style": {
          "enum": [
            "pressing",
            "counter",
            "possession",
            "balanced"
          ],
          "title": "Style",
          "type": "string"
        },
        "system": {
          "description": "e.g. 4-3-3",
          "pattern": "^[1-9](-[1-9]){2,4}$",
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "style",
        "system"
      ],
      "title": "Tactic",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A full squad. Its `sources` and `verify` cover the squad as a whole.",
  "properties": {
    "club": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Club"
    },
    "club_season": {
      "maxLength": 64,
      "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
      "title": "Club Season",
      "type": "string"
    },
    "default_tactic": {
      "$ref": "#/$defs/Tactic",
      "default": {
        "style": "balanced",
        "system": "4-4-2"
      }
    },
    "players": {
      "items": {
        "$ref": "#/$defs/PlayerEntry"
      },
      "minItems": 1,
      "title": "Players",
      "type": "array"
    },
    "real_league": {
      "anyOf": [
        {
          "$ref": "#/$defs/RealLeague"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "season": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Season",
      "type": "string"
    },
    "sources": {
      "description": "URLs backing the datum.",
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "verify": {
      "enum": [
        "ok",
        "pending"
      ],
      "title": "Verify",
      "type": "string"
    }
  },
  "required": [
    "sources",
    "verify",
    "schema_version",
    "club_season",
    "club",
    "season",
    "real_league",
    "players"
  ],
  "title": "SquadFile",
  "type": "object"
}
