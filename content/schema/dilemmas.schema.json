{
  "$defs": {
    "BoardConfidenceEffect": {
      "additionalProperties": false,
      "description": "Changes the board's confidence in the manager.",
      "properties": {
        "delta": {
          "maximum": 25,
          "minimum": -25,
          "title": "Delta",
          "type": "integer"
        },
        "type": {
          "const": "board_confidence",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "delta"
      ],
      "title": "BoardConfidenceEffect",
      "type": "object"
    },
    "CompetitionPriorityEffect": {
      "additionalProperties": false,
      "description": "Sets how much the manager rotates in a competition versus the others.",
      "properties": {
        "competition_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition Id",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "type": {
          "const": "competition_priority",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "competition_id",
        "priority"
      ],
      "title": "CompetitionPriorityEffect",
      "type": "object"
    },
    "Dilemma": {
      "additionalProperties": false,
      "description": "A dilemma of a block. Exactly one option is the historical one.",
      "properties": {
        "block": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Block",
          "type": "string"
        },
        "historical_option": {
          "$ref": "#/$defs/HistoricalOption"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "block",
        "title",
        "prompt",
        "options",
        "historical_option"
      ],
      "title": "Dilemma",
      "type": "object"
    },
    "FitnessEffect": {
      "additionalProperties": false,
      "description": "Changes the fitness of the whole squad, or of one player when `player_id` is set.",
      "properties": {
        "delta": {
          "maximum": 30,
          "minimum": -30,
          "title": "Delta",
          "type": "integer"
        },
        "player_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "type": {
          "const": "fitness",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "delta"
      ],
      "title": "FitnessEffect",
      "type": "object"
    },
    "HistoricalOption": {
      "additionalProperties": false,
      "description": "Which option the real manager took, with the sources that prove it.",
      "properties": {
        "option": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Option",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "option"
      ],
      "title": "HistoricalOption",
      "type": "object"
    },
    "InjuryEffect": {
      "additionalProperties": false,
      "description": "A forced injury: the player is out from `date` for `days` days.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "type": {
          "const": "injury",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "player_id",
        "date",
        "days"
      ],
      "title": "InjuryEffect",
      "type": "object"
    },
    "MoraleEffect": {
      "additionalProperties": false,
      "description": "Changes the morale of the whole squad.",
      "properties": {
        "delta": {
          "maximum": 20,
          "minimum": -20,
          "title": "Delta",
          "type": "integer"
        },
        "type": {
          "const": "morale",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "delta"
      ],
      "title": "MoraleEffect",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "description": "One possible answer to a dilemma, with its effects.",
      "properties": {
        "effects": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "board_confidence": "#/$defs/BoardConfidenceEffect",
                "competition_priority": "#/$defs/CompetitionPriorityEffect",
                "fitness": "#/$defs/FitnessEffect",
                "injury": "#/$defs/InjuryEffect",
                "morale": "#/$defs/MoraleEffect",
                "player_morale": "#/$defs/PlayerMoraleEffect",
                "sell_player": "#/$defs/SellPlayerEffect",
                "set_tactic": "#/$defs/SetTacticEffect",
                "sign_player": "#/$defs/SignPlayerEffect",
                "youth_minutes": "#/$defs/YouthMinutesEffect"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MoraleEffect"
              },
              {
                "$ref": "#/$defs/PlayerMoraleEffect"
              },
              {
                "$ref": "#/$defs/SignPlayerEffect"
              },
              {
                "$ref": "#/$defs/SellPlayerEffect"
              },
              {
                "$ref": "#/$defs/SetTacticEffect"
              },
              {
                "$ref": "#/$defs/CompetitionPriorityEffect"
              },
              {
                "$ref": "#/$defs/BoardConfidenceEffect"
              },
              {
                "$ref": "#/$defs/YouthMinutesEffect"
              },
              {
                "$ref": "#/$defs/InjuryEffect"
              },
              {
                "$ref": "#/$defs/FitnessEffect"
              }
            ]
          },
          "title": "Effects",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "PlayerMoraleEffect": {
      "additionalProperties": false,
      "description": "Changes the morale of one player.",
      "properties": {
        "delta": {
          "maximum": 30,
          "minimum": -30,
          "title": "Delta",
          "type": "integer"
        },
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "type": {
          "const": "player_morale",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "player_id",
        "delta"
      ],
      "title": "PlayerMoraleEffect",
      "type": "object"
    },
    "SellPlayerEffect": {
      "additionalProperties": false,
      "description": "Removes a player from the manager's squad, optionally into a rival's squad.",
      "properties": {
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "to_club_season": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Club Season"
        },
        "type": {
          "const": "sell_player",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "player_id"
      ],
      "title": "SellPlayerEffect",
      "type": "object"
    },
    "SetTacticEffect": {
      "additionalProperties": false,
      "description": "Sets the team's playing style and system.",
      "properties": {
        "style": {
          "enum": [
            "pressing",
            "counter",
            "possession",
            "balanced"
          ],
          "title": "Style",
          "type": "string"
        },
        "system": {
          "description": "e.g. 4-3-3",
          "pattern": "^[1-9](-[1-9]){2,4}$",
          "title": "System",
          "type": "string"
        },
        "type": {
          "const": "set_tactic",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "style",
        "system"
      ],
      "title": "SetTacticEffect",
      "type": "object"
    },
    "SignPlayerEffect": {
      "additionalProperties": false,
      "description": "Adds a player to the manager's squad.\n\nWith `from_club_season`, the player leaves that rival's squad (he must be in it).\nWithout it, he comes from the market or from outside the game.",
      "properties": {
        "from_club_season": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Club Season"
        },
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "type": {
          "const": "sign_player",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "player_id"
      ],
      "title": "SignPlayerEffect",
      "type": "object"
    },
    "YouthMinutesEffect": {
      "additionalProperties": false,
      "description": "Gives minutes to a young player.",
      "properties": {
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "type": {
          "const": "youth_minutes",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "player_id"
      ],
      "title": "YouthMinutesEffect",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "All dilemmas of the season.",
  "properties": {
    "dilemmas": {
      "items": {
        "$ref": "#/$defs/Dilemma"
      },
      "minItems": 1,
      "title": "Dilemmas",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "dilemmas"
  ],
  "title": "DilemmasFile",
  "type": "object"
}
