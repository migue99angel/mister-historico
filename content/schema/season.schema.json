{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "A stretch of the season. Blocks must not overlap; each ends on a standings cutoff.",
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "start",
        "end"
      ],
      "title": "Block",
      "type": "object"
    },
    "BoardObjective": {
      "additionalProperties": false,
      "description": "What the board expects in a competition. Editorial, not a historical datum.",
      "properties": {
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "win",
            "finish_top",
            "reach_stage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Position"
        },
        "target_stage": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Stage"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "competition",
        "kind",
        "text"
      ],
      "title": "BoardObjective",
      "type": "object"
    },
    "CompetitionOutcome": {
      "additionalProperties": false,
      "description": "What really happened in a competition.",
      "properties": {
        "champion": {
          "title": "Champion",
          "type": "boolean"
        },
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "eliminated_in": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eliminated In"
        },
        "final_position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Position"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition",
        "champion",
        "final_position",
        "eliminated_in"
      ],
      "title": "CompetitionOutcome",
      "type": "object"
    },
    "ContinentalCupCompetition": {
      "additionalProperties": false,
      "description": "A continental cup, with a group stage and/or knockout rounds.",
      "properties": {
        "goal_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalBaselineFromLeague"
            },
            {
              "$ref": "#/$defs/GoalStats"
            }
          ],
          "title": "Goal Baseline"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "continental_cup",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "tier": {
          "enum": [
            "continental_primary",
            "continental_secondary"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "participants",
        "goal_baseline",
        "stages",
        "kind",
        "tier"
      ],
      "title": "ContinentalCupCompetition",
      "type": "object"
    },
    "CupCompetition": {
      "additionalProperties": false,
      "description": "A domestic cup.",
      "properties": {
        "goal_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalBaselineFromLeague"
            },
            {
              "$ref": "#/$defs/GoalStats"
            }
          ],
          "title": "Goal Baseline"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "cup",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "tier": {
          "const": "domestic_cup",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "participants",
        "goal_baseline",
        "stages",
        "kind",
        "tier"
      ],
      "title": "CupCompetition",
      "type": "object"
    },
    "GoalBaselineFromLeague": {
      "additionalProperties": false,
      "description": "Reuse the goal statistics of a league of the same season.",
      "properties": {
        "from_league": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "From League",
          "type": "string"
        }
      },
      "required": [
        "from_league"
      ],
      "title": "GoalBaselineFromLeague",
      "type": "object"
    },
    "GoalStats": {
      "additionalProperties": false,
      "description": "Goals scored by the home and the away sides over a number of matches.\n\nIt gives the engine its goal baseline and home advantage.",
      "properties": {
        "away_goals": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Away Goals"
        },
        "home_goals": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Home Goals"
        },
        "matches": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matches"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "matches",
        "home_goals",
        "away_goals"
      ],
      "title": "GoalStats",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "description": "A group of a group stage.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "participants"
      ],
      "title": "Group",
      "type": "object"
    },
    "InjuryEvent": {
      "additionalProperties": false,
      "description": "A real injury that really happened and is replayed in every run.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "player_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Player Id",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "type": {
          "const": "injury",
          "title": "Type",
          "type": "string"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "type",
        "player_id",
        "date",
        "days"
      ],
      "title": "InjuryEvent",
      "type": "object"
    },
    "LeagueCompetition": {
      "additionalProperties": false,
      "description": "A league: single or double round robin, with configurable points and tiebreakers.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "league",
          "title": "Kind",
          "type": "string"
        },
        "league_stats": {
          "$ref": "#/$defs/GoalStats"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        },
        "points_per_draw": {
          "maximum": 1,
          "minimum": 0,
          "title": "Points Per Draw",
          "type": "integer"
        },
        "points_per_win": {
          "maximum": 3,
          "minimum": 2,
          "title": "Points Per Win",
          "type": "integer"
        },
        "rounds": {
          "enum": [
            1,
            2
          ],
          "title": "Rounds",
          "type": "integer"
        },
        "tiebreakers": {
          "items": {
            "$ref": "#/$defs/Tiebreaker"
          },
          "minItems": 1,
          "title": "Tiebreakers",
          "type": "array"
        },
        "tier": {
          "const": "domestic_league",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "participants",
        "kind",
        "tier",
        "rounds",
        "points_per_win",
        "points_per_draw",
        "tiebreakers",
        "league_stats"
      ],
      "title": "LeagueCompetition",
      "type": "object"
    },
    "Manager": {
      "additionalProperties": false,
      "description": "The real manager of the season.",
      "properties": {
        "alias_name": {
          "minLength": 1,
          "title": "Alias Name",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "display_name",
        "alias_name"
      ],
      "title": "Manager",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "description": "A round of a knockout competition, or its group stage (`round: group_stage`).\n\nFormat and rules are set per competition and per season. The group fields are required\nfor a group stage and forbidden otherwise.",
      "properties": {
        "advance_per_group": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advance Per Group"
        },
        "away_goals_rule": {
          "title": "Away Goals Rule",
          "type": "boolean"
        },
        "extra_time": {
          "title": "Extra Time",
          "type": "boolean"
        },
        "groups": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Group"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groups"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "legs": {
          "enum": [
            1,
            2
          ],
          "title": "Legs",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "penalties": {
          "title": "Penalties",
          "type": "boolean"
        },
        "points_per_draw": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Draw"
        },
        "points_per_win": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Win"
        },
        "round": {
          "enum": [
            "qualifying",
            "playoff",
            "group_stage",
            "round_of_128",
            "round_of_64",
            "round_of_32",
            "round_of_16",
            "quarter_final",
            "semi_final",
            "final"
          ],
          "title": "Round",
          "type": "string"
        },
        "tiebreakers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tiebreaker"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiebreakers"
        }
      },
      "required": [
        "id",
        "name",
        "round",
        "legs",
        "away_goals_rule",
        "extra_time",
        "penalties"
      ],
      "title": "Stage",
      "type": "object"
    },
    "SuperCupCompetition": {
      "additionalProperties": false,
      "description": "A domestic super cup.",
      "properties": {
        "goal_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalBaselineFromLeague"
            },
            {
              "$ref": "#/$defs/GoalStats"
            }
          ],
          "title": "Goal Baseline"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "super_cup",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "tier": {
          "const": "domestic_super_cup",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "participants",
        "goal_baseline",
        "stages",
        "kind",
        "tier"
      ],
      "title": "SuperCupCompetition",
      "type": "object"
    },
    "Tactic": {
      "additionalProperties": false,
      "description": "A playing style plus a system.",
      "properties": {
        "style": {
          "enum": [
            "pressing",
            "counter",
            "possession",
            "balanced"
          ],
          "title": "Style",
          "type": "string"
        },
        "system": {
          "description": "e.g. 4-3-3",
          "pattern": "^[1-9](-[1-9]){2,4}$",
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "style",
        "system"
      ],
      "title": "Tactic",
      "type": "object"
    },
    "Tiebreaker": {
      "description": "Tiebreak criteria for league tables, applied in the listed order.",
      "enum": [
        "head_to_head_points",
        "head_to_head_goal_difference",
        "head_to_head_goals_for",
        "head_to_head_away_goals",
        "goal_difference",
        "goals_for",
        "wins"
      ],
      "title": "Tiebreaker",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The playable season: everything that references club-seasons but is not a squad.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "board_objectives": {
      "items": {
        "$ref": "#/$defs/BoardObjective"
      },
      "minItems": 1,
      "title": "Board Objectives",
      "type": "array"
    },
    "club_season": {
      "maxLength": 64,
      "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
      "title": "Club Season",
      "type": "string"
    },
    "competitions": {
      "items": {
        "discriminator": {
          "mapping": {
            "continental_cup": "#/$defs/ContinentalCupCompetition",
            "cup": "#/$defs/CupCompetition",
            "league": "#/$defs/LeagueCompetition",
            "super_cup": "#/$defs/SuperCupCompetition"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/LeagueCompetition"
          },
          {
            "$ref": "#/$defs/CupCompetition"
          },
          {
            "$ref": "#/$defs/SuperCupCompetition"
          },
          {
            "$ref": "#/$defs/ContinentalCupCompetition"
          }
        ]
      },
      "minItems": 1,
      "title": "Competitions",
      "type": "array"
    },
    "forced_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InjuryEvent"
      },
      "title": "Forced Events",
      "type": "array"
    },
    "historical_outcome": {
      "items": {
        "$ref": "#/$defs/CompetitionOutcome"
      },
      "minItems": 1,
      "title": "Historical Outcome",
      "type": "array"
    },
    "initial_tactic": {
      "$ref": "#/$defs/Tactic"
    },
    "manager": {
      "$ref": "#/$defs/Manager"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "season": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Season",
      "type": "string"
    },
    "slug": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "slug",
    "club_season",
    "season",
    "manager",
    "initial_tactic",
    "blocks",
    "competitions",
    "board_objectives",
    "historical_outcome"
  ],
  "title": "SeasonFile",
  "type": "object"
}
