{
  "$defs": {
    "GroupEntryAssignment": {
      "additionalProperties": false,
      "description": "Historical representative of an explicit group position in a target stage.",
      "properties": {
        "group_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Group Id",
          "type": "string"
        },
        "historical_representative": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Historical Representative",
          "type": "string"
        },
        "qualifying_position": {
          "minimum": 1,
          "title": "Qualifying Position",
          "type": "integer"
        },
        "source_stage_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Source Stage Id",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "target_stage_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Target Stage Id",
          "type": "string"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "source_stage_id",
        "group_id",
        "qualifying_position",
        "target_stage_id",
        "historical_representative"
      ],
      "title": "GroupEntryAssignment",
      "type": "object"
    },
    "GroupEntryAssignments": {
      "additionalProperties": false,
      "description": "All explicitly sourced qualifying positions of one competition.",
      "properties": {
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "entries": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GroupEntryAssignment"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entries"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition",
        "entries"
      ],
      "title": "GroupEntryAssignments",
      "type": "object"
    },
    "HeadToHeadEvidence": {
      "additionalProperties": false,
      "description": "Editorial declaration of all matches between covered clubs through an inclusive date.",
      "properties": {
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "complete_through": {
          "format": "date",
          "title": "Complete Through",
          "type": "string"
        },
        "covered_clubs": {
          "items": {
            "maxLength": 64,
            "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Covered Clubs",
          "type": "array"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/HeadToHeadResult"
          },
          "title": "Results",
          "type": "array"
        },
        "schedule": {
          "items": {
            "$ref": "#/$defs/HeadToHeadFixture"
          },
          "title": "Schedule",
          "type": "array"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stage": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition",
        "complete_through",
        "covered_clubs",
        "schedule",
        "results"
      ],
      "title": "HeadToHeadEvidence",
      "type": "object"
    },
    "HeadToHeadFixture": {
      "additionalProperties": false,
      "description": "One dated home/away match in a declared complete calendar.",
      "properties": {
        "away": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Away",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "fixture_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Fixture Id",
          "type": "string"
        },
        "home": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Home",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "venue": {
          "anyOf": [
            {
              "enum": [
                "home",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "fixture_id",
        "date",
        "home",
        "away"
      ],
      "title": "HeadToHeadFixture",
      "type": "object"
    },
    "HeadToHeadResult": {
      "additionalProperties": false,
      "description": "A regulation-time score, home first, identified by its calendar fixture.",
      "properties": {
        "fixture_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Fixture Id",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 30,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 30,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "fixture_id",
        "score"
      ],
      "title": "HeadToHeadResult",
      "type": "object"
    },
    "KnockoutCalendar": {
      "additionalProperties": false,
      "description": "A complete explicit calendar for one competition; a null collection is pending.",
      "properties": {
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "slots": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/KnockoutSlot"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slots"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition",
        "slots"
      ],
      "title": "KnockoutCalendar",
      "type": "object"
    },
    "KnockoutSlot": {
      "additionalProperties": false,
      "description": "Calendar identity of a historical slot; its future occupants are separate game state.",
      "properties": {
        "away": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Away",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "fixture_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Fixture Id",
          "type": "string"
        },
        "home": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Home",
          "type": "string"
        },
        "leg": {
          "anyOf": [
            {
              "enum": [
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leg"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stage_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Stage Id",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "enum": [
                "home",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "fixture_id",
        "stage_id",
        "date",
        "home",
        "away",
        "venue"
      ],
      "title": "KnockoutSlot",
      "type": "object"
    },
    "RealTie": {
      "additionalProperties": false,
      "description": "A real knockout tie, including those that do not involve the own team (P2).",
      "properties": {
        "aggregate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate"
        },
        "clubs": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxLength": 64,
              "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "maxLength": 64,
              "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
              "type": "string"
            }
          ],
          "title": "Clubs",
          "type": "array"
        },
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stage": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Stage",
          "type": "string"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        },
        "winner": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Winner"
        }
      },
      "required": [
        "sources",
        "verify",
        "competition",
        "stage",
        "clubs",
        "winner"
      ],
      "title": "RealTie",
      "type": "object"
    },
    "StandingRow": {
      "additionalProperties": false,
      "description": "One row of a real league table.",
      "properties": {
        "club_season": {
          "maxLength": 64,
          "pattern": "^_?[a-z0-9]+(-[a-z0-9]+)*-\\d{4}-\\d{2}$",
          "title": "Club Season",
          "type": "string"
        },
        "drawn": {
          "minimum": 0,
          "title": "Drawn",
          "type": "integer"
        },
        "goals_against": {
          "minimum": 0,
          "title": "Goals Against",
          "type": "integer"
        },
        "goals_for": {
          "minimum": 0,
          "title": "Goals For",
          "type": "integer"
        },
        "lost": {
          "minimum": 0,
          "title": "Lost",
          "type": "integer"
        },
        "played": {
          "minimum": 0,
          "title": "Played",
          "type": "integer"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "won": {
          "minimum": 0,
          "title": "Won",
          "type": "integer"
        }
      },
      "required": [
        "club_season",
        "position",
        "played",
        "won",
        "drawn",
        "lost",
        "goals_for",
        "goals_against",
        "points"
      ],
      "title": "StandingRow",
      "type": "object"
    },
    "StandingsCutoff": {
      "additionalProperties": false,
      "description": "The real league table on the cutoff date of a block.",
      "properties": {
        "block": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Block",
          "type": "string"
        },
        "competition": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Competition",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "sources": {
          "description": "URLs backing the datum.",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stage": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "table": {
          "items": {
            "$ref": "#/$defs/StandingRow"
          },
          "minItems": 2,
          "title": "Table",
          "type": "array"
        },
        "verify": {
          "enum": [
            "ok",
            "pending"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "verify",
        "block",
        "competition",
        "date",
        "table"
      ],
      "title": "StandingsCutoff",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Real tables at each block cutoff and the real bracket of the knockout competitions.",
  "properties": {
    "cutoffs": {
      "items": {
        "$ref": "#/$defs/StandingsCutoff"
      },
      "title": "Cutoffs",
      "type": "array"
    },
    "group_entry_assignments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/GroupEntryAssignments"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Entry Assignments"
    },
    "head_to_head": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/HeadToHeadEvidence"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head To Head"
    },
    "knockout_calendar": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/KnockoutCalendar"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knockout Calendar"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "ties": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RealTie"
      },
      "title": "Ties",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "cutoffs"
  ],
  "title": "StandingsFile",
  "type": "object"
}
